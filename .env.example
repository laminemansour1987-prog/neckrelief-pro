# Copie ce fichier en `.env` et remplis tes propres cles.
# `app.py` et `webhook_server.py` chargent automatiquement `.env` (python-dotenv).

# --- Compte(s) administrateur (panneau Admin + email de contact affiche aux clients) ---
# Par defaut : laminemansour1987@gmail.com. Plusieurs emails possibles, separes par des virgules.
OWNER_CONTACT_EMAIL=laminemansour1987@gmail.com
ADMIN_EMAILS=laminemansour1987@gmail.com

# --- Analyse IA optionnelle (Claude) ---
ANTHROPIC_API_KEY=

# --- Stripe (abonnement clients) ---
# Cle secrete de ton compte Stripe (dashboard Stripe > Developpeurs > Cles API).
STRIPE_SECRET_KEY=
# Price ID des plans recurrents (Stripe dashboard > Produits > ton produit > Prix).
STRIPE_PRICE_ID_MONTHLY=
STRIPE_PRICE_ID_YEARLY=
# Signing secret affiche lors de la creation de l'endpoint de webhook.
STRIPE_WEBHOOK_SECRET=

# URL publique du dashboard (utilisee pour les redirections Stripe Checkout
# et le portail de gestion d'abonnement).
APP_BASE_URL=http://localhost:8501

# --- Bases de donnees locales (chemins par defaut si non definis) ---
USERS_DB=users.db
TREND_PREDICTOR_DB=watchlist.db
