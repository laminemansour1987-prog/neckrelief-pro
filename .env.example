# --- Base de données ---
# SQLite en local par défaut. Pour passer en production sur Postgres,
# changez `provider = "sqlite"` en `provider = "postgresql"` dans
# prisma/schema.prisma et pointez DATABASE_URL vers votre instance
# (ex: Neon, Supabase, RDS), puis relancez `npx prisma db push`.
DATABASE_URL="file:./dev.db"

# --- Session (auth) ---
# Requis en production pour signer les cookies de session. Sans elle, un
# secret est généré et persisté localement (pratique en dev uniquement).
SESSION_SECRET=

# --- IA (Anthropic Claude) ---
# Sans cette clé, /api/chat répond en "mode démo" (réponses factices) au lieu d'appeler l'IA.
ANTHROPIC_API_KEY=

# --- Stripe (abonnements) ---
# Clé secrète Stripe (mode test ou live), depuis https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=

# Secret de signature du webhook Stripe, depuis https://dashboard.stripe.com/webhooks
STRIPE_WEBHOOK_SECRET=

# IDs des prix récurrents créés dans Stripe (Produits > Prix) pour chaque plan payant
STRIPE_PRICE_ID_PLUS=
STRIPE_PRICE_ID_PRO=

# URL publique de l'application (utilisée pour les redirections Stripe Checkout)
NEXT_PUBLIC_APP_URL=http://localhost:3000
