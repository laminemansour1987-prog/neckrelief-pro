# Port du serveur
PORT=3000

# Jeton simple pour proteger le tableau de bord admin (routes /api/appointments, /api/events, /api/stats)
ADMIN_TOKEN=changeme

# --- IA conversationnelle (optionnel) ---
# Sans cle, l'agent fonctionne quand meme avec des reponses pre-redigees de qualite.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# --- Calendrier / creneaux automatiques ---
# Determine les creneaux proposes par l'agent et evite tout double-booking.
WORK_START_HOUR=8
WORK_END_HOUR=18
SLOT_HOURS=2
MAX_CONCURRENT_JOBS=1
URGENT_BUFFER_MINUTES=45
NORMAL_BUFFER_HOURS=2

# --- Notification email automatique vers votre Gmail (optionnel) ---
# Gmail : SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=votre adresse gmail,
# SMTP_PASS=un "mot de passe d'application" (pas votre mot de passe habituel),
# a generer sur myaccount.google.com/apppasswords (necessite la validation en 2 etapes).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=votre-adresse@gmail.com
SMTP_PASS=
SMTP_FROM=votre-adresse@gmail.com
ADMIN_EMAIL=votre-adresse@gmail.com

# --- SMS automatiques (optionnel, via Twilio) ---
# Necessite un compte sur twilio.com (essai gratuit) : TWILIO_ACCOUNT_SID et
# TWILIO_AUTH_TOKEN se trouvent sur la console Twilio, TWILIO_FROM_NUMBER est
# le numero Twilio fourni (different de votre numero personnel).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Votre numero personnel (format international, ex: +33612345678) : recoit une
# alerte SMS a chaque nouvelle demande, en plus de l'email.
ADMIN_PHONE=
